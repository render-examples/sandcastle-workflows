# Copy to .env for local runs. `render workflows dev` loads it automatically.

# Render API key and workspace (tea-...). Used on the host to create sandboxes.
# Never forwarded into a sandbox.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# GitHub token with contents and pull-request write access to the target repo.
# Used on the host to read issues, push branches, and open pull requests.
# Never forwarded into a sandbox.
GITHUB_TOKEN=

# Claude Code login (run `claude setup-token`). Forwarded into each sandbox,
# where the agent can read it.
CLAUDE_CODE_OAUTH_TOKEN=
